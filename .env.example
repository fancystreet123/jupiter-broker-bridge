# ── Copy this file to ".env" and fill in the blanks. Never commit the real .env. ──

# Your Interactive Brokers login (the SAME one you use on their website).
# These live ONLY on your always-on host — never in Jupiter, never shared.
IB_USERNAME=your_ibkr_username
IB_PASSWORD=your_ibkr_password

# paper = practice money (start here). Change to "live" only after the 2-week test.
TRADING_MODE=paper
IB_PORT=4002          # 4002 = paper, 4001 = live. Match TRADING_MODE.

# A long random password Jupiter will use to talk to the bridge. Make one up
# (e.g. run: openssl rand -hex 24). Keep it secret; you'll paste it into Jupiter too.
BRIDGE_TOKEN=replace_with_a_long_random_string

# Safety rails (leave these ON while testing):
PAPER_ONLY=true        # bridge refuses to trade anything that isn't a paper account
MAX_ORDER_USD=50000    # catches only runaway/bug orders. Your engine trades ~$20k/position,
                       # so this never blocks a normal trade — it only stops a sizing bug from
                       # firing a giant order. Set to 0 to disable entirely (not recommended
                       # even in paper: the paper run is a rehearsal for live code).
ALLOW_SYMBOLS=         # optional: limit to e.g. SPY,QQQ,AAPL  (blank = allow all)
